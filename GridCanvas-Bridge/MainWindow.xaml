<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GridCanvas_Bridge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GridCanvas_Bridge"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GridCanvas Bridge">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*">

        <!-- ToolBar -->
        <Grid Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              Padding="8,4" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

            <Button Grid.Column="0" Content="開く" Margin="0,0,4,0" Click="OnOpenFile"/>
            <Button Grid.Column="1" Content="保存" Margin="0,0,4,0" Click="OnSaveFile"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="縦横比:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="AspectRatioCombo" Width="80" SelectedIndex="0"
                          SelectionChanged="OnAspectRatioChanged">
                    <ComboBoxItem Content="16:9"/>
                    <ComboBoxItem Content="4:3"/>
                </ComboBox>
            </StackPanel>

            <Button Grid.Column="4" Content="⛶ 全画面" Margin="0,0,4,0" Click="OnFullScreen"/>
            <Button Grid.Column="5" Content="🖨 PDF印刷" Click="OnPrint"/>
        </Grid>

        <!-- Main content: Slide list | WebView2 | Property panel -->
        <Grid Grid.Row="1" ColumnDefinitions="160,*,200">

            <!-- Slide thumbnail list -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ListView x:Name="SlideListView" Grid.Row="0"
                          SelectionChanged="OnSlideSelected"
                          Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="8,4" Margin="0,2">
                                <TextBlock Text="{Binding}" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Padding="4">
                    <Button Content="◀" Width="36" Margin="2" Click="OnPrevSlide"/>
                    <Button Content="▶" Width="36" Margin="2" Click="OnNextSlide"/>
                </StackPanel>
            </Grid>

            <!-- WebView2 rendering area -->
            <Grid Grid.Column="1" Background="#1e1e2e">
                <WebView2 x:Name="SlideWebView"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>
            </Grid>

            <!-- Property panel -->
            <ScrollViewer Grid.Column="2"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          Padding="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="プロパティ" FontWeight="SemiBold" Margin="0,0,0,4"/>

                    <!-- Selected element info -->
                    <StackPanel x:Name="ElementPropertyPanel" Visibility="Collapsed" Spacing="4">
                        <TextBlock Text="選択要素:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="SelectedElementId" FontSize="12" FontFamily="Consolas"/>

                        <TextBlock Text="グリッド位置:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="4">
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="X:" FontSize="11"/>
                            <NumberBox x:Name="GridXBox" Grid.Column="1" Grid.Row="0"
                                       SpinButtonPlacementMode="Hidden" FontSize="12"
                                       ValueChanged="OnGridPositionChanged"/>
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Y:" FontSize="11"/>
                            <NumberBox x:Name="GridYBox" Grid.Column="1" Grid.Row="1"
                                       SpinButtonPlacementMode="Hidden" FontSize="12"
                                       ValueChanged="OnGridPositionChanged"/>
                        </Grid>

                        <TextBlock Text="グリッドサイズ:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="4">
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="W:" FontSize="11"/>
                            <NumberBox x:Name="GridWBox" Grid.Column="1" Grid.Row="0"
                                       SpinButtonPlacementMode="Hidden" FontSize="12"
                                       ValueChanged="OnGridSizeChanged"/>
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="H:" FontSize="11"/>
                            <NumberBox x:Name="GridHBox" Grid.Column="1" Grid.Row="1"
                                       SpinButtonPlacementMode="Hidden" FontSize="12"
                                       ValueChanged="OnGridSizeChanged"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="NoSelectionText" Text="要素を選択してください"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <!-- Paste from clipboard -->
                    <Button Content="クリップボードから貼り付け" Margin="0,16,0,0"
                            HorizontalAlignment="Stretch" Click="OnPasteFromClipboard"/>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
